# Cuenta administradora de PostgreSQL (dueña del esquema): solo para administración, la API no la usa.
POSTGRES_USER=smartpot-root
POSTGRES_PASSWORD=<ROOT_PASSWORD>
POSTGRES_DB=smartpot

# Usuario de la aplicación (solo DML sobre su base, sin permisos de esquema). Mínimo 16 caracteres.
SMARTPOT_DB_USERNAME=smartpot
SMARTPOT_DB_PASSWORD=<APP_PASSWORD>

# Carga la cuenta demo@smartpot.app con dos cultivos y 48 h de lecturas. Solo en local o demo.
SMARTPOT_SEED_DEMO=false

# Opcional: rol de ingesta de telemetría con commit asíncrono (por defecto, la misma clave de la aplicación).
# SMARTPOT_INGEST_USERNAME=smartpot_ingest
# SMARTPOT_INGEST_PASSWORD=<INGEST_PASSWORD>
# Opcional: rol de solo lectura para SmartPot-Trainer (readings y crops.id/type/kind). Sin clave no se crea.
# SMARTPOT_READER_USERNAME=smartpot_reader
# SMARTPOT_READER_PASSWORD=<READER_PASSWORD>
