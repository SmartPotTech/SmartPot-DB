# Cuenta root de MongoDB: solo para administración, la API no la usa.
MONGO_INITDB_ROOT_USERNAME=smartpot-root
MONGO_INITDB_ROOT_PASSWORD=<ROOT_PASSWORD>

# Base y usuario de la aplicación (readWrite solo sobre su base). Mínimo 16 caracteres.
SMARTPOT_DB_NAME=smartpot
SMARTPOT_DB_USERNAME=smartpot
SMARTPOT_DB_PASSWORD=<APP_PASSWORD>

# Carga la cuenta demo@smartpot.app con dos cultivos y 48 h de lecturas. Solo en local o demo.
SMARTPOT_SEED_DEMO=false
